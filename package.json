{
  "name": "vacation-rental-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI automation framework validating booking workflows across different vacation rental websites.",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "pretest": "npm run allure:clean",
    "test": "playwright test",
    "test:alice": "playwright test --project=alice-chromium --project=alice-firefox --project=alice-webkit --project=alice-edge",
    "test:firesky": "playwright test --project=firesky-chromium --project=firesky-firefox --project=firesky-webkit --project=firesky-edge",
    "test:goodlife": "playwright test --project=goodlife-chromium --project=goodlife-firefox --project=goodlife-webkit --project=goodlife-edge",
    "test:chromium": "playwright test --project=alice-chromium --project=firesky-chromium --project=goodlife-chromium",
    "test:firefox": "playwright test --project=alice-firefox --project=firesky-firefox --project=goodlife-firefox",
    "test:webkit": "playwright test --project=alice-webkit --project=firesky-webkit --project=goodlife-webkit",
    "test:edge": "playwright test --project=alice-edge --project=firesky-edge --project=goodlife-edge",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:ui:docker": "playwright test --ui --project=alice-chromium --ui-host=0.0.0.0 --ui-port=9224",
    "report": "playwright show-report --host 0.0.0.0 --port 9323",
    "allure:clean": "rm -rf allure-results allure-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open -p 9000 allure-report",
    "allure:serve": "allure serve -p 9000 allure-results",
    "report:allure": "npm run allure:generate && npm run allure:open",
    "codegen:alice": "playwright codegen https://www.alicelodging.com",
    "codegen:firesky": "playwright codegen https://www.fireskyretreats.com",
    "codegen:goodlife": "playwright codegen https://www.goodliferetreats.com",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf allure-results allure-report playwright-report test-results",
    "prepare": "husky",
    "postinstall": "playwright install chromium firefox webkit msedge"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.ts,*.tsx,*.js,*.jsx": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
