{
  "name": "vacation-rental-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI automation framework validating booking workflows across AliceLodging and FireskyRetreats",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "test": "playwright test",
    "test:alice": "playwright test --project=alice-lodging",
    "test:firesky": "playwright test --project=firesky-retreats",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open -p 9000 allure-report",
    "allure:serve": "allure serve -p 9000 allure-results",
    "report:allure": "npm run allure:generate && npm run allure:open",
    "codegen:alice": "playwright codegen https://www.alicelodging.com",
    "codegen:firesky": "playwright codegen https://www.fireskyretreats.com",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf allure-results allure-report playwright-report test-results",
    "prepare": "husky",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
